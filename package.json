{
  "name": "harshdipsaha-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-images.mjs && node scripts/build-llms-txt.mjs && node scripts/build-process-stats.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-images.mjs && node scripts/build-llms-txt.mjs && node scripts/build-process-stats.mjs",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "images": "node scripts/build-images.mjs",
    "llms": "node scripts/build-llms-txt.mjs",
    "stats": "node scripts/build-process-stats.mjs",
    "check:aidlc": "node scripts/check-aidlc-sync.mjs",
    "test:unit": "node --test evals scripts",
    "eval:factuality": "node evals/factuality/run.mjs",
    "postbuild": "node scripts/postbuild-segments.mjs",
    "test:smoke": "playwright test",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.17.30",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.5",
    "playwright": "^1.62.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "simple-icons": "^16.29.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  }
}
