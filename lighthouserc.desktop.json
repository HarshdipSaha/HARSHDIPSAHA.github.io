{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/packages/utils/src/lighthouserc-schema.json",
  "ci": {
    "collect": {
      "startServerCommand": "npx serve out -l 3200 -n -L --no-port-switching",
      "startServerReadyPattern": "Accepting connections",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/story",
        "http://localhost:3200/projects",
        "http://localhost:3200/projects/atomnet",
        "http://localhost:3200/writing",
        "http://localhost:3200/process",
        "http://localhost:3200/gallery"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop",
      "reportFilenamePattern": "%%PATHNAME%%.%%DATETIME%%.report.%%EXTENSION%%"
    }
  }
}
