{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/packages/utils/src/lighthouserc-schema.json",
  "ci": {
    "collect": {
      "startServerCommand": "npx serve out -l 3201 -n -L --no-port-switching",
      "startServerReadyPattern": "Accepting connections",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3201/",
        "http://localhost:3201/story",
        "http://localhost:3201/projects",
        "http://localhost:3201/projects/atomnet",
        "http://localhost:3201/process",
        "http://localhost:3201/gallery"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile",
      "reportFilenamePattern": "%%PATHNAME%%.%%DATETIME%%.report.%%EXTENSION%%"
    }
  }
}
