# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# generated by scripts/build-images.mjs (manifest src/data/images.json IS committed)
/public/img/
/.cache/

# generated by scripts/build-llms-txt.mjs on predev/prebuild
/public/llms.txt
/public/llms-full.txt

# local scratch: reference captures, the 63 MB MNI download
/.ref/

# env
.env*.local
.DS_Store

# impeccable design skill — installed locally with `npx impeccable install`, not committed
.github/skills/impeccable/
.github/agents/impeccable-*
.github/hooks/
# impeccable working files: design.json + critique snapshots ARE committed (they pair with DESIGN.md);
# screenshot reviews and live-mode config are scratch.
.impeccable/review/
.impeccable/live/

# UI/UX Pro Max skill (nextlevelbuilder/ui-ux-pro-max-skill) — third-party, reinstall with `npx uipro-cli init`
.github/skills/ui-ux-pro-max/

# quality gates (npm run test:smoke / npm run lighthouse:*)
/.lighthouseci/
/test-results/
/playwright-report/

# subagent worktrees
/.claude/worktrees/
