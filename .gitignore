# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# generated by scripts/build-images.mjs (manifest src/data/images.json IS committed)
/public/img/
/.cache/

# generated by scripts/build-llms-txt.mjs on predev/prebuild
/public/llms.txt
/public/llms-full.txt

# local scratch: reference captures, the 63 MB MNI download
/.ref/

# env
.env*.local
.DS_Store

# impeccable design skill — installed locally with `npx impeccable install`, not committed
.github/skills/impeccable/
.github/agents/impeccable-*
.github/hooks/
# impeccable working files: design.json + critique snapshots ARE committed (they pair with DESIGN.md);
# screenshot reviews and live-mode config are scratch.
.impeccable/review/
.impeccable/live/

# UI/UX Pro Max skill (nextlevelbuilder/ui-ux-pro-max-skill) — third-party, reinstall with `npx uipro-cli init`
.github/skills/ui-ux-pro-max/

# quality gates (npm run test:smoke / npm run lighthouse:*)
/.lighthouseci/
/test-results/
/playwright-report/

# subagent worktrees
/.claude/worktrees/

# factuality eval report (npm run eval:factuality); uploaded as a CI artifact, never committed
/.evals/

# LaTeX build byproducts (npm run resume:build / CI compile of resume/resume.tex);
# public/resume.pdf itself IS committed — deploy.yml has no LaTeX toolchain, so the
# compiled PDF is a checked-in artefact like public/img is not, same as before this
# pipeline existed (see AGENTS.md "Images are built, never hand-copied").
resume/*.aux
resume/*.log
resume/*.out
resume/*.fls
resume/*.fdb_latexmk
resume/*.synctex.gz
/.scratch/
