# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at build (sync-gallery)
/src/data/gallery.json
# impeccable (design skill) — vendored by `npx impeccable install`, not committed.
# 153 files / 3.5MB of third-party skill code that drifts with upstream.
# Reinstall with: npx impeccable install
.github/skills/impeccable/
.github/agents/impeccable-*
.github/hooks/
.impeccable/

# build-time image pipeline cache (scripts/optimize-images.mjs)
/.cache/

# Responsive image ladder — 126 files / ~7.7MB regenerated by `prebuild`
# (scripts/optimize-images.mjs). The manifest IS committed so `tsc` works in a
# fresh clone before the first build; the binaries do not need to be.
/public/images/responsive/
